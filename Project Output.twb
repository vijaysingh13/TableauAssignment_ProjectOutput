    <worksheet name='KPI-Profit Margin'>
      <layout-options>
        <caption>
          <formatted-text>
            <run>DESCRIPTION
Profit margin displays profits as a percentage of sales and demonstrates the efficiency of turning the sales 
into profits.

ANALYSIS/ BUSINESS PERSPECTIVE
The profit margin KPI assists managers in assessing the quality of their sales and not just their volume. The 
reduction of margin can reveal discount pressure or product mix change to the less profitable side.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sample - Superstore' name='federated.0xgffwl0x9lrlw1g0nbqy1vzka5g' />
          </datasources>
          <datasource-dependencies datasource='federated.0xgffwl0x9lrlw1g0nbqy1vzka5g'>
            <column caption='Profit Margin' datatype='real' name='[Calculation_1860951591018497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Profit])/sum([Sales])' />
            </column>
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column datatype='string' name='[Segment]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1860951591018497]' derivation='User' name='[usr:Calculation_1860951591018497:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0xgffwl0x9lrlw1g0nbqy1vzka5g].[Action (Segment)]'>
            <groupfilter function='level-members' level='[Segment]' user:ui-action-filter='[Action1_74EB87C9B02F40A8A39D8F4821129353]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.0xgffwl0x9lrlw1g0nbqy1vzka5g].[Action (Segment)]</column>
          </slices>
          <aggregation value='true' />
        </view>

      <aliases enabled='yes' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales])) / TOTAL(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI Selector' datatype='string' name='[Calculation_1186695594487811]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1186695591550976]&#13;&#10;  WHEN &apos;Total Sales&apos; THEN &quot;$&quot; + STR(ROUND(SUM([Sales]) / 1000000, 2)) + &quot;M&quot;&#13;&#10;  WHEN &apos;Profit Margin&apos; THEN STR(ROUND((SUM([Profit]) / SUM([Sales])) * 100, 2)) + &quot;%&quot;&#13;&#10;  WHEN &apos;Total Profit&apos; THEN &quot;$&quot; + STR(ROUND(SUM([Profit]) / 1000, 2)) + &quot;K&quot;&#13;&#10;  WHEN &apos;Total Customers&apos; THEN STR(COUNTD([Customer ID]))&#13;&#10;  WHEN &apos;Total Orders&apos; THEN STR(COUNTD([Order ID]))&#13;&#10;  WHEN &apos;Average Order Value&apos; THEN &quot;$&quot; + STR(ROUND(SUM([Sales]) / COUNTD([Order ID]), 2))&#13;&#10;END' />
      </column>
      <column caption='Average Order Value' datatype='real' default-format='C1031%' name='[Calculation_1860951589806080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])/COUNTD([Order ID])' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Calculation_1860951591018497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/sum([Sales])' />
      </column>
      <column caption='cumulative sales%' datatype='real' name='[Calculation_2254853812928513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))/WINDOW_SUM(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>

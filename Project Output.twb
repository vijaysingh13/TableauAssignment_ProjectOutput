    <worksheet name='Top-Performing Sub-Categories'>
      <layout-options>
        <caption>
          <formatted-text>
            <run>DESCRIPTION
This is a stacked bar graph showing the performance of various product subcategories in terms of their 
sales performance.

ANALYSIS / BUSINESS PERSPECTIVE
This graph is useful for managers as it can show them what subcategories are performing well 
commercially and need more visibility in their marketing plans and merchandizing activities. Sales figures should be looked at along with profits as high sales figures do not always mean good profitability.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sample - Superstore' name='federated.0xgffwl0x9lrlw1g0nbqy1vzka5g' />
          </datasources>
          <datasource-dependencies datasource='federated.0xgffwl0x9lrlw1g0nbqy1vzka5g'>
            <column caption='Profit Margin' datatype='real' name='[Calculation_1860951591018497]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Profit])/sum([Sales])' />
            </column>
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Quantity]' role='measure' type='quantitative' />
            <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column datatype='string' name='[Sub-Category]' role='dimension' type='nominal' />
            <column-instance column='[Sub-Category]' derivation='None' name='[none:Sub-Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Profit]' derivation='Sum' name='[sum:Profit:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Quantity]' derivation='Sum' name='[sum:Quantity:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1860951591018497]' derivation='User' name='[usr:Calculation_1860951591018497:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0xgffwl0x9lrlw1g0nbqy1vzka5g].[none:Sub-Category:nk]'>
            <groupfilter count='5' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([Sales])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:Sub-Category:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>

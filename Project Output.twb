    <dashboard name='Customer and Product insights Story' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='1110' />
        </style-rule>
      </style>
      <size maxheight='964' maxwidth='1600' minheight='964' minwidth='1600' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='7' param='vert' removable='false' type-v2='layout-flow' w='99000' x='500' y='830'>
            <zone h='5913' id='8' type-v2='title' w='99000' x='500' y='830'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='92427' id='1' param='vert' removable='false' type-v2='layout-flow' w='99000' x='500' y='6743'>
              <zone fixed-size='139' h='14419' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='99000' x='500' y='6743' />
              <zone h='78008' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99000' x='500' y='21162'>
                <flipboard active-id='4' nav-type='caption' show-nav-arrows='true'>
                  <story-points>
                    <story-point caption='Revenue Concentration is achieved by finding the main customer cluster that contributes to the first 80 percent of the revenues.' captured-sheet='Customer Pareto Chart' id='4' />
                    <story-point caption='Identifies those products that have high demand and which should be a priority for merchandising and promotions along with ensuring that profits do not fall.' captured-sheet='Top-Performing Sub-Categories' id='3' />
                    <story-point caption='Shows typical spending ranges for customers to help determine price levels, free shipping limits, and upsell offers.' captured-sheet='Order-Value Distribution using bins' id='2' />
                    <story-point caption='After assessing the level of performance, the Customer and Product insights dashboard analyzes the situation within the customer and product base. It assesses the scale of both customers and orders, finds out if a smaller number of customers &#10;accounts for a high proportion of sales, uncovers strong subcategories, and explores the distribution of order &#10;&#10;This dashboard is dedicated to revealing who drives the company’s success and what kind of buying behaviour customers have. The Pareto chart defines the strategically important clients, the subcategory ranking &#10;defines the demand-generating products, and the distribution of order values provides information on basket &#10;behavior.' captured-sheet='Customer and Product insights' id='1' />
                  </story-points>
                </flipboard>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{FC76322C-3064-412F-A157-AB7CA5CA095F}' />
    </dashboard>

    <worksheet name='KPI Selection'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='20'>&lt;Sheet Name&gt;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontsize='18'><![CDATA[<[Parameters].[Parameter 1186695591550976]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sample - Superstore' name='federated.0xgffwl0x9lrlw1g0nbqy1vzka5g' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='KPI Selector' datatype='string' name='[Parameter 1186695591550976]' param-domain-type='list' role='measure' type='nominal' value='&quot;Profit Margin&quot;'>
              <calculation class='tableau' formula='&quot;Profit Margin&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xgffwl0x9lrlw1g0nbqy1vzka5g'>
            <column caption='KPI Selector' datatype='string' name='[Calculation_1186695594487811]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1186695591550976]&#13;&#10;  WHEN &apos;Total Sales&apos; THEN &quot;$&quot; + STR(ROUND(SUM([Sales]) / 1000000, 2)) + &quot;M&quot;&#13;&#10;  WHEN &apos;Profit Margin&apos; THEN STR(ROUND((SUM([Profit]) / SUM([Sales])) * 100, 2)) + &quot;%&quot;&#13;&#10;  WHEN &apos;Total Profit&apos; THEN &quot;$&quot; + STR(ROUND(SUM([Profit]) / 1000, 2)) + &quot;K&quot;&#13;&#10;  WHEN &apos;Total Customers&apos; THEN STR(COUNTD([Customer ID]))&#13;&#10;  WHEN &apos;Total Orders&apos; THEN STR(COUNTD([Order ID]))&#13;&#10;  WHEN &apos;Average Order Value&apos; THEN &quot;$&quot; + STR(ROUND(SUM([Sales]) / COUNTD([Order ID]), 2))&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Customer ID]' role='dimension' type='nominal' />
            <column aggregation='CountD' datatype='string' default-role='measure' default-type='quantitative' name='[Order ID]' role='dimension' type='nominal' />
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1186695594487811]' derivation='User' name='[usr:Calculation_1186695594487811:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='height' value='84' />
            <format attr='width' value='449' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.0xgffwl0x9lrlw1g0nbqy1vzka5g].[usr:Calculation_1186695594487811:nk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontsize='18'>&lt;</run>
                <run fontsize='18'>[federated.0xgffwl0x9lrlw1g0nbqy1vzka5g].[usr:Calculation_1186695594487811:nk]</run>
                <run fontsize='18'>&gt;</run>
              </formatted-text>

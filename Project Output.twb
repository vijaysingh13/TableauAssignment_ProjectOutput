    <dashboard name='Marketing Performance Overview Story' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Marketing Performance Overview Story</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='1097' />
        </style-rule>
      </style>
      <size maxheight='964' maxwidth='1600' minheight='964' minwidth='1600' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='99000' x='500' y='830'>
            <zone h='5083' id='3' type-v2='title' w='99000' x='500' y='830' />
            <zone fixed-size='133' h='13797' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='99000' x='500' y='5913' />
            <zone h='79460' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99000' x='500' y='19710'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Highlights peaks in seasonal demand, growth trends, and instances of disconnect between sales and profits—identifying months when heavy sales have been undermined by declining margins.' captured-sheet='Monthly Sales and Profit Trend ' id='5' />
                  <story-point caption='Identifies the buyer category that generates the majority of income to allow appropriate budgeting for customer retention or acquisition programs.' captured-sheet='Sales By Customer Segment ' id='4' />
                  <story-point caption='Determines relative demand for each key product line to determine promotion strategy, bundle offers, and inventory decisions.' captured-sheet='Sales By Category' id='3' />
                  <story-point caption='The Marketing Performance Overview dashboard provides managers with an overview of the performance of their commercial operations. Firstly, it demonstrates the size and profitability of the business based on three KPIs, then highlights the trends of performance and identifies those customer segments and product categories that have been contributing most to sales. This Dashboard was developed in order to provide an answer to the first management question: &quot;How are we performing, and where is demand coming from?&quot;&#10;&#10;This Dashboard provides managers with the picture of the whole business operation. Managers can find out whether their revenue and profits are growing hand-in-hand, which customer segments create the highest demand, and which product categories are driving sales.' captured-sheet='Marketing Performance Overview' id='1' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{20CE5344-49A0-4C88-AD37-95E8250EFFD3}' />
    </dashboard>

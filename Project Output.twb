    <worksheet name='KPI-Average Order Value'>
      <layout-options>
        <caption>
          <formatted-text>
            <run>Description
The KPI reflects the value that each sales order generates on average.

Analysis/Business Perspective
The Average Order Value is a measure of the value that each purchase from a customer brings.
The marketing department can use it to evaluate the effectiveness of cross-selling, bundles, premium product promotion, and minimum spend offers.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sample - Superstore' name='federated.0xgffwl0x9lrlw1g0nbqy1vzka5g' />
          </datasources>
          <datasource-dependencies datasource='federated.0xgffwl0x9lrlw1g0nbqy1vzka5g'>
            <column caption='Average Order Value' datatype='real' default-format='C1031%' name='[Calculation_1860951589806080]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Sales])/COUNTD([Order ID])' />
            </column>
            <column aggregation='CountD' datatype='string' default-role='measure' default-type='quantitative' name='[Order ID]' role='dimension' type='nominal' />
            <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column datatype='string' name='[Sub-Category]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1860951589806080]' derivation='User' name='[usr:Calculation_1860951589806080:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0xgffwl0x9lrlw1g0nbqy1vzka5g].[Action (Sub-Category)]'>
            <groupfilter function='level-members' level='[Sub-Category]' user:ui-action-filter='[Action2_42B9DF3D8CC0456E84D8509A0D9382AF]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.0xgffwl0x9lrlw1g0nbqy1vzka5g].[Action (Sub-Category)]</column>
          </slices>
          <aggregation value='true' />
        </view>

    <worksheet name='Order-Value Distribution using bins'>
      <layout-options>
        <caption>
          <formatted-text>
            <run>DESCRIPTION
This histogram categorizes orders based on value ranges, indicating the frequency of various orders.

ANALYSIS/BUSINESS PERSPECTIVE
The distribution assists managers in determining normal basket size for customers and identifying whether orders are predominantly made in low-, medium-, or high-value ranges. This could be used for pricing, bundling, free shipping, and other campaigns that aim to shift customers to high-value ranges.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sample - Superstore' name='federated.0xgffwl0x9lrlw1g0nbqy1vzka5g' />
          </datasources>
          <datasource-dependencies datasource='federated.0xgffwl0x9lrlw1g0nbqy1vzka5g'>
            <column caption='Order Value' datatype='real' name='[Calculation_2254853818507267]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Order ID]: SUM([Sales])}' />
            </column>
            <column aggregation='CountD' datatype='string' default-role='measure' default-type='quantitative' name='[Order ID]' role='dimension' type='nominal' />
            <column aggregation='None' caption='Order Value Range ($)' datatype='integer' name='[Order Value (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='2' formula='[Calculation_2254853818507267]' peg='0' size='100' />
            </column>
            <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column datatype='string' name='[Sub-Category]' role='dimension' type='nominal' />
            <column-instance column='[Order ID]' derivation='CountD' name='[ctd:Order ID:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Order Value (bin)]' derivation='None' name='[none:Order Value (bin):ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0xgffwl0x9lrlw1g0nbqy1vzka5g].[Action (Sub-Category)]'>
            <groupfilter function='level-members' level='[Sub-Category]' user:ui-action-filter='[Action2_42B9DF3D8CC0456E84D8509A0D9382AF]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.0xgffwl0x9lrlw1g0nbqy1vzka5g].[Action (Sub-Category)]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.0xgffwl0x9lrlw1g0nbqy1vzka5g].[ctd:Order ID:qk]' scope='rows' value='Numberof Orders' />
          </style-rule>
